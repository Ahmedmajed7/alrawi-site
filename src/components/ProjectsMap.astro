---
/** The projects map (company profile, page 17: "more than … projects across the Sultanate of Oman"): a night band where
    Oman lies as a lit plate in perspective. The coast draws itself, the nine regions fill in the logo's blue → green by
    their count, a column of light rises from each to its height in projects while the total counts up, and light runs
    out from Muscat to the others. Beside it the same figures as a ledger; a row, a region and its column light together.
    Shapes: src/data/oman-map.json (scripts/build-oman-map.mjs); counts and names: src/data/projects.json. */
import map from '@/data/oman-map.json';
import projects from '@/data/projects.json';
import { useT, l, type Locale } from '@/i18n/utils';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
const [W, H] = map.viewBox;
const max = Math.max(...projects.regions.map((r) => r.n));
const shape = new Map(map.regions.map((r) => [r.id, r]));
// the logo's blue → green by count (a square-root scale, so 1 and 91 both read)
const RAMP = [[58, 96, 184], [59, 153, 212], [112, 208, 96]];
const tint = (k: number) => {
  const [a, b, f] = k < 0.5 ? [RAMP[0], RAMP[1], k * 2] : [RAMP[1], RAMP[2], (k - 0.5) * 2];
  return `rgb(${a.map((v, i) => Math.round(v + (b[i] - v) * f)).join(' ')})`;
};
const regions = projects.regions.map((r, i) => {
  const s = shape.get(r.id)!;
  const k = Math.sqrt(r.n / max);
  return { ...r, i, d: s.d, x: s.at[0], y: s.at[1], k, c: tint(k), share: r.n / max, name: l(r.name, locale) };
});
const hub = regions[0]; // Muscat, where the office is
// light runs from Muscat to every other region along a shallow curve in the plane
const arcs = regions.slice(1).map((r) => {
  const dx = r.x - hub.x, dy = r.y - hub.y, bow = 0.2;
  const cx = (hub.x + r.x) / 2 - dy * bow, cy = (hub.y + r.y) / 2 + dx * bow;
  return { i: r.i, c: r.c, d: `M${hub.x} ${hub.y}Q${cx.toFixed(1)} ${cy.toFixed(1)} ${r.x} ${r.y}` };
});
const pct = (v: number, of: number) => ((v / of) * 100).toFixed(2);
---
<section class="band pm" id="projects" data-tone="dusk" data-pm>
  <div class="pm-sky" aria-hidden="true"><i class="pm-glow pm-glow-a"></i><i class="pm-glow pm-glow-b"></i></div>
  <div class="wrap pm-grid">
    <div class="pm-text">
      <span class="kicker pm-kicker">{t('projects.eyebrow')}</span>
      <h2 class="pm-title">
        <span class="pm-pre">{t('projects.pre')}</span>
        <span class="pm-total num" data-pm-total={projects.total}>{projects.total}</span>
        <span class="pm-post">{t('projects.post')}</span>
      </h2>
      <ol class="pm-list">
        {regions.map((r) => (
          <li class="pm-row" data-pm-id={r.id} tabindex="0" style={`--c:${r.c};--w:${r.share.toFixed(4)};--i:${r.i}`}>
            <span class="pm-name">{r.name}</span>
            <span class="pm-bar" aria-hidden="true"><i></i></span>
            <b class="pm-count num">{r.n}</b>
            <span class="sr-only">{t('projects.unit')}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="pm-stage">
      <div class="pm-scene">
        <div class="pm-plate">
          <svg class="pm-under pm-halo" viewBox={`0 0 ${W} ${H}`} aria-hidden="true"><use href="#pm-outline" /></svg>
          {[3, 2, 1].map((n) => <svg class="pm-under pm-slab" style={`--z:${n}`} viewBox={`0 0 ${W} ${H}`} aria-hidden="true"><use href="#pm-outline" /></svg>)}
          <svg class="pm-map" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t('projects.map')}>
            <defs><path id="pm-outline" d={map.outline} pathLength="1" /></defs>
            <use class="pm-base" href="#pm-outline" />
            <g class="pm-regions">
              {regions.map((r) => <path class="pm-region" data-pm-id={r.id} d={r.d} style={`--c:${r.c};--o:${(0.2 + r.k * 0.62).toFixed(3)};--i:${r.i}`} />)}
            </g>
            <use class="pm-coast" href="#pm-outline" />
            <g class="pm-arcs">
              {arcs.map((a) => <g style={`--c:${a.c};--i:${a.i}`}><path class="pm-arc" d={a.d} pathLength="1" /><path class="pm-run" d={a.d} pathLength="1" /></g>)}
            </g>
            <g class="pm-nodes">
              {regions.map((r) => (
                <g class="pm-node" data-pm-id={r.id} style={`--c:${r.c};--i:${r.i}`} transform={`translate(${r.x} ${r.y})`}>
                  <circle class="pm-ring" r={(9 + r.k * 22).toFixed(1)} />
                  <circle class="pm-dot" r={(3 + r.k * 4).toFixed(1)} />
                </g>
              ))}
            </g>
          </svg>
          <ul class="pm-cols" aria-hidden="true">
            {regions.map((r) => (
              <li class="pm-col" data-pm-id={r.id} style={`--x:${pct(r.x, W)}%;--y:${pct(r.y, H)}%;--h:${Math.max(0.03, r.share).toFixed(4)};--c:${r.c};--i:${r.i}`}>
                <span class="pm-beam"></span>
                <span class="pm-tip"><em class="pm-tag">{r.name}</em><b class="num" data-pm-n={r.n}>{r.n}</b></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initProjectsMap } from '@/scripts/motion/map';
  initProjectsMap();
</script>
