---
/** The film's target reticle, standalone: segmented rings, a crosshair, corner brackets and a readout tag.
    Placed at `x`,`y` (0..1 of its positioned parent, e.g. a blueprint Figure); motion/hero.ts locks it on. */
import { arc, ticks, bracket } from '@/scripts/film/hud-geometry';
interface Props { x: number; y: number; label?: string; class?: string }
const { x, y, label = '', class: cls = '' } = Astro.props;
const box = '-50 -50 100 100';
---
<div class:list={['ret', cls]} data-ret data-x={x} data-y={y} style={`left:${x * 100}%;top:${y * 100}%`} aria-hidden="true">
  <svg class="ret-ring ret-a" viewBox={box}><circle r="17" /></svg>
  <svg class="ret-ring ret-b" viewBox={box}><path d={[0, 120, 240].map((a) => arc(0, 0, 26, a + 12, a + 96)).join('')} /></svg>
  <svg class="ret-ring ret-c" viewBox={box}><circle r="35" /><path d={ticks(0, 0, 35, 39.5, 4, 0)} /><path class="is-fine" d={ticks(0, 0, 32.6, 35, 48)} /></svg>
  <svg class="ret-ring ret-x" viewBox={box}><path d={ticks(0, 0, 4.5, 11, 4, 0)} /><circle class="is-dot" r="1.3" /></svg>
  {[0, 1, 2, 3].map((k) => <svg class={`ret-br ret-br-${k}`} viewBox="0 0 14 14"><path d={bracket(13.5, 4.5)} /></svg>)}
  {label && <b class="ret-tag" dir="ltr"><span>{label}</span><i data-ret-xy></i></b>}
</div>
