---
import type { Locale } from '@/i18n/utils';
import { l, localePath } from '@/i18n/utils';
import Icon from '@/components/Icons.astro';
import categories from '@/data/categories.json';
import type { Product } from '@/lib/products';

interface Props { product: Product; locale: Locale; eager?: boolean; index?: number }
const { product: p, locale, eager = false, index } = Astro.props;
const cat = categories.find((c) => c.slug === p.category)!;
const href = localePath(locale, `products/${p.category}/${p.slug}`);
---
<article class="prod-card" data-reveal data-lock>
  <div class="prod-media">
    <img src={p.image.replace('.webp', '-card.webp')} alt={l(p.name, locale)} width="480" height="480" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    <i class="prod-scan" aria-hidden="true"></i>
    {index !== undefined && <span class="prod-no num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
  </div>
  <div class="prod-body">
    <span class="prod-cat">{l(cat.name, locale)}</span>
    <h3>{l(p.name, locale)}</h3>
    <p>{l(p.tagline, locale)}</p>
    <span class="prod-go" aria-hidden="true"><Icon name="arrow" class="icon-dir" /></span>
  </div>
  <a class="stretch" href={href} aria-label={l(p.name, locale)}></a>
</article>
