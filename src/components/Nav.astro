---
import type { Locale } from '@/i18n/utils';
import { useT, localePath, altLocalePath, otherLocale, l } from '@/i18n/utils';
import Logo from '@/components/Logo.astro';
import site from '@/data/site.json';

interface Props { locale: Locale; light?: boolean }
const { locale, light = false } = Astro.props;
const t = useT(locale);
const path = Astro.url.pathname;
const other = otherLocale(locale);
// the live site's pages (Home, About, Smart Control, Contact) plus the product catalogue
const links = [
  { href: localePath(locale), label: t('nav.home'), exact: true },
  { href: localePath(locale, 'about'), label: t('nav.about') },
  { href: localePath(locale, 'smart-control'), label: t('nav.control') },
  { href: localePath(locale, 'products'), label: t('nav.products') },
  { href: localePath(locale, 'contact'), label: t('nav.contact') },
];
const isCurrent = (href: string, exact = false) => (exact ? path === href : path.startsWith(href));
const wa = `https://wa.me/${site.whatsapp}`;
---
<header class:list={['nav', { 'on-night': !light }]} data-nav data-light={light ? '1' : '0'}>
  <div class="wrap nav-inner">
    <a class="nav-logo" href={localePath(locale)} aria-label={l(site.name, locale)}>
      <Logo />
      <span>{locale === 'ar' ? 'الراوي' : 'AL RAWI'}<small>{locale === 'ar' ? 'للمنازل الذكية' : 'SMART HOME'}</small></span>
    </a>
    <nav class="nav-links" aria-label={t('nav.menu')}>
      {links.map((x) => <a href={x.href} aria-current={isCurrent(x.href, x.exact) ? 'page' : undefined}><span>{x.label}</span><i class="nb nb0"></i><i class="nb nb1"></i><i class="nb nb2"></i><i class="nb nb3"></i></a>)}
    </nav>
    <div class="nav-actions">
      <a class="lang-toggle" href={altLocalePath(path, other)} hreflang={other} lang={other} aria-label={t('nav.langAria')} data-lang-toggle data-lang={other}>{t('nav.lang')}</a>
      <a class="btn btn-sm nav-cta" href={wa} target="_blank" rel="noopener" data-magnetic><span class="dot"></span>{t('nav.quote')}</a>
      <button class="nav-burger" type="button" aria-label={t('nav.menu')} aria-expanded="false" aria-controls="drawer" data-burger><span></span></button>
    </div>
  </div>
  <i class="nav-progress" aria-hidden="true"></i>
</header>
<div class="nav-drawer" id="drawer" data-drawer>
  <div class="drawer-grid" aria-hidden="true"></div>
  <nav class="drawer-links">
    {links.map((x, i) => <a href={x.href} style={`--i:${i}`} aria-current={isCurrent(x.href, x.exact) ? 'page' : undefined}><b class="num">{String(i + 1).padStart(2, '0')}</b><span>{x.label}</span></a>)}
  </nav>
  <div class="drawer-foot">
    <a class="btn btn-sun" href={wa} target="_blank" rel="noopener">{t('nav.quote')}</a>
    <a class="btn" href={altLocalePath(path, other)} hreflang={other} lang={other} data-lang-toggle data-lang={other}>{t('nav.lang')}</a>
  </div>
</div>
