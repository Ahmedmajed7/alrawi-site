---
/** An instrument dial (the HUD's climate dial): ticks, a track, an arc that sweeps in and a counter in the middle. */
import { arc, ticks } from '@/scripts/film/hud-geometry';
interface Props { n: number; suffix?: string; label: string; fill?: number; big?: boolean }
const { n, suffix = '', label, fill = 0.78, big = false } = Astro.props;
---
<div class:list={['dial', { 'dial--big': big }]} data-reveal="dial" style={`--f:${fill}`}>
  <svg viewBox="0 0 120 120" aria-hidden="true">
    <path class="dial-ticks" d={ticks(60, 60, 54, 58, 40, 135, 270)} />
    <path class="dial-track" d={arc(60, 60, 47, 135, 405)} />
    <path class="dial-fill" d={arc(60, 60, 47, 135, 405)} pathLength="1" />
  </svg>
  <b class="num" data-count={n} data-suffix={suffix}>0{suffix}</b>
  <span>{label}</span>
</div>
