---
/** Al Rawi "R" mark (paths in data/logo.ts). The navy stroke follows --logo-ink so it reads on dark grounds. */
import { LOGO_PATHS, LOGO_VIEWBOX } from '@/data/logo';
interface Props { class?: string; mono?: boolean }
const { class: cls = '', mono = false } = Astro.props;
const fill = (i: number) => (mono ? 'currentColor' : i === 0 ? 'var(--logo-ink, #18254f)' : LOGO_PATHS[i].color);
---
<svg class:list={['logo', cls]} viewBox={`0 0 ${LOGO_VIEWBOX[0]} ${LOGO_VIEWBOX[1]}`} aria-hidden="true">
  {LOGO_PATHS.map((p, i) => <path fill={fill(i)} d={p.d} />)}
</svg>
