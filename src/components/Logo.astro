---
/** Stylised approximation of the Al Rawi mark (R bowl + three stepped bars). Replace with the client's SVG when supplied. */
interface Props { class?: string; gradient?: boolean }
const { class: cls = '', gradient = true } = Astro.props;
const id = `lg${Math.random().toString(36).slice(2, 7)}`;
---
<svg class={cls} viewBox="0 0 100 100" aria-hidden="true">
  {gradient && (
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#35e0ff" />
        <stop offset="1" stop-color="#2f80ff" />
      </linearGradient>
    </defs>
  )}
  <g fill={gradient ? `url(#${id})` : 'currentColor'}>
    <path d="M36 6h24a24 24 0 0 1 0 48h-8v-12h8a12 12 0 0 0 0-24H48z" />
    <path d="M36 6h12L18 44H6z" />
    <path d="M6 44h44v11H18z" />
    <path d="M18 61h32v11H30z" />
    <path d="M30 78h20v11H42z" />
  </g>
</svg>
