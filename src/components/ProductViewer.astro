---
import type { Locale } from '@/i18n/utils';
import { useT, l } from '@/i18n/utils';
import Icon from '@/components/Icons.astro';
import type { Product } from '@/lib/products';
interface Props { product: Product; locale: Locale }
const { product: p, locale } = Astro.props;
const t = useT(locale);
const name = l(p.name, locale);
---
<div class="viewer" data-viewer data-slug={p.slug} data-shape={p.shape} data-params={JSON.stringify(p.shapeParams)} data-model={p.model ? '1' : '0'} data-accent={p.accent} data-aria={t('product.viewer.aria', { name })}>
  <div class="viewer-fallback"><img src={p.image} srcset={`${p.image.replace('.webp', '-card.webp')} 480w, ${p.image} 1200w`} sizes="(max-width: 760px) 90vw, 600px" alt={name} width="1200" height="1200" fetchpriority="high" decoding="async" /></div>
  <span class="viewer-badge" data-badge data-tap={t('product.viewer.tap')}>3D</span>
  <span class="viewer-status" data-status data-hint={t('product.viewer.hint')} data-fallback={t('product.viewer.fallback')}><i class="ring"></i>{t('product.viewer.loading')}</span>
  <button class="viewer-reset" type="button" data-reset aria-label={t('product.viewer.reset')}><Icon name="reset" /></button>
</div>
<script>
  // three.js is loaded on demand: desktop when the viewer nears the viewport, phones on tap.
  const phone = window.matchMedia('(pointer: coarse)').matches || window.innerWidth < 760;
  const load = () => import('@/scripts/three/product-viewer');
  document.querySelectorAll<HTMLElement>('[data-viewer]').forEach((el) => {
    if (el.dataset.mounted) return; el.dataset.mounted = '1';
    const go = () => load().then(({ mountViewer }) => mountViewer(el)).catch((err) => console.error('[viewer]', err));
    if (phone) {
      const btn = el.querySelector<HTMLElement>('[data-badge]');
      if (btn) { btn.textContent = btn.dataset.tap || '3D'; btn.classList.add('is-tap'); }
      el.addEventListener('click', () => { btn?.classList.remove('is-tap'); if (btn) btn.textContent = '3D'; go(); }, { once: true });
      return;
    }
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); go(); } }, { rootMargin: '200px' });
    io.observe(el);
  });
</script>
