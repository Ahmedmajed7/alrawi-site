---
/** Drafting watermark (Dartz): a hairline figure at very low contrast in a section corner, drifting with the scroll. */
interface Props { kind?: 'rings' | 'arc' | 'protractor'; class?: string }
const { kind = 'rings', class: cls = '' } = Astro.props;
---
<svg class:list={['wm', `wm--${kind}`, cls]} viewBox="0 0 400 400" aria-hidden="true" data-drift="0.12">
  {kind === 'rings' && [40, 80, 120, 160, 196].map((r) => <circle cx="200" cy="200" r={r} />)}
  {kind === 'rings' && <path d="M200 0V400M0 200H400" />}
  {kind === 'arc' && <><path d="M20 380A360 360 0 0 1 380 20" /><path d="M60 380A320 320 0 0 1 380 60" /><path d="M20 380H380V20" /></>}
  {kind === 'protractor' && <><path d="M20 300a180 180 0 0 1 360 0z" />{Array.from({ length: 19 }, (_, i) => { const a = Math.PI - (i * Math.PI) / 18; const r1 = i % 3 ? 164 : 150; return <path d={`M${200 + 180 * Math.cos(a)} ${300 - 180 * Math.sin(a)}L${200 + r1 * Math.cos(a)} ${300 - r1 * Math.sin(a)}`} />; })}<circle cx="200" cy="300" r="6" /></>}
</svg>
