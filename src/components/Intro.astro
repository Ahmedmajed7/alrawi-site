---
import type { Locale } from '@/i18n/utils';
import { useT, localePath, strings } from '@/i18n/utils';
import Logo from '@/components/Logo.astro';
import Icon from '@/components/Icons.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
const s = strings(locale);
const nodes = Object.entries(s.intro.nodes) as [string, string][];
const title = locale === 'ar' ? ['منزلك،', 'بلمسة واحدة'] : ['Your home,', 'one touch ahead'];
---
<div class="intro-loader" data-intro-loader aria-live="polite">
  <div class="intro-loader-inner">
    <Logo class="intro-mark" />
    <div class="intro-bar"><i data-bar></i></div>
    <p>{t('intro.loading')}</p>
  </div>
  <button class="intro-skip" type="button" data-skip>{t('intro.skip')}</button>
</div>

<section class="hero" data-hero aria-label={t('hero.title')}>
  <div class="hero-poster" aria-hidden="true"><img src="/img/brand/intro-poster.webp" alt="" width="1600" height="900" fetchpriority="high" /></div>
  <div class="hero-canvas" data-hero-canvas aria-hidden="true"></div>
  <div class="hero-labels" aria-hidden="true">
    {nodes.map(([k, v]) => <span class="hero-label" data-node-label={k}>{v}</span>)}
  </div>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="wrap hero-content">
    <span class="eyebrow" data-hero-el>{t('hero.eyebrow')}</span>
    <h1 data-hero-el>{title[0]}<br /><span class="hl">{title[1]}</span></h1>
    <p data-hero-el>{t('hero.subtitle')}</p>
    <div class="hero-actions" data-hero-el>
      <a class="btn btn-primary" href={localePath(locale, 'products')}>{t('hero.cta')} <Icon name="arrow" class="icon-dir" /></a>
      <a class="btn btn-ghost" href="#contact">{t('hero.cta2')}</a>
    </div>
  </div>
  <div class="hero-scroll" aria-hidden="true"><span>{t('hero.scroll')}</span><i></i></div>
</section>
<script>
  import { mountIntro } from '@/scripts/three/intro-scene';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) mountIntro(hero);
</script>
