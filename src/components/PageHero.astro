---
/** Inner-page opening: breadcrumbs, an optional kicker, the title in the display serif over a short brass rule, a lead,
    on warm ivory with a faint golden-hour light from the top corner (the film's warmth, no ornament). */
interface Props { eyebrow?: string; title: string; lead?: string; crumbs?: { href?: string; label: string }[] }
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
---
<section class="ph band band--paper" data-tone="lime" data-ph>
  <div class="wrap ph-inner">
    {crumbs.length > 0 && (
      <ol class="breadcrumb" data-ph-in>{crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}</ol>
    )}
    {eyebrow && <span class="kicker" data-ph-in style="--d:0.08s">{eyebrow}</span>}
    <h1 class="ph-title" data-ph-in style="--d:0.12s" set:html={title} />
    <i class="ph-rule" data-ph-in style="--d:0.3s" aria-hidden="true"></i>
    {lead && <p class="ph-lead" data-ph-in style="--d:0.38s">{lead}</p>}
    <slot />
  </div>
</section>
