---
/** Blueprint drawings of the devices (no screenshots): hairline line-work drawn stroke by stroke when revealed, with
    centre lines, dimension ticks and grid letters. `kind` picks the subject; the reticle locks on at `target()`. */
import Reticle from '@/components/Reticle.astro';
interface Props { kind: 'panel' | 'lock' | 'villa' | 'devices' | 'signal'; label?: string; class?: string }
const { kind, label, class: cls = '' } = Astro.props;
const TARGETS = { panel: [0.47, 0.45], lock: [0.5, 0.36], villa: [0.5, 0.73], devices: [0.29, 0.33], signal: [0.5, 0.5] } as const;
const [tx, ty] = TARGETS[kind];
let n = 0; const k = () => `--k:${n++}`; // draw order
const dots = (cx: number, cy: number, cols: number, rows: number, gap: number, r = 3.2) =>
  Array.from({ length: cols * rows }, (_, i) => ({ x: cx + (i % cols) * gap, y: cy + Math.floor(i / cols) * gap, r }));
---
<figure class:list={['fig', `fig--${kind}`, cls]} data-reveal="fig" aria-hidden="true">
  <svg viewBox="0 0 400 400">
    <g class="fig-grid">
      <path d="M200 10V390M10 200H390" class="cl" />
      <path d="M20 20h14M20 20v14M380 20h-14M380 20v14M20 380h14M20 380v-14M380 380h-14M380 380v-14" class="reg" />
      <text x="24" y="50">A1</text><text x="354" y="50">A2</text><text x="24" y="368">B1</text><text x="354" y="368">B2</text>
    </g>
    {kind === 'panel' && (
      <g class="fig-art">
        <rect class="dr dash" x="104" y="112" width="192" height="150" style={k()} pathLength="1" />
        <rect class="dr" x="92" y="100" width="216" height="174" style={k()} pathLength="1" />
        <rect class="dr" x="110" y="118" width="150" height="138" style={k()} pathLength="1" />
        <path class="dr" d="M124 142h52M124 158h34M124 212h122M124 228h96M124 244h72" style={k()} pathLength="1" />
        <circle class="dr" cx="224" cy="160" r="24" style={k()} pathLength="1" />
        <path class="dr" d="M280 130v26M280 176v26M280 222v26" style={k()} pathLength="1" />
        <path class="dim" d="M92 76h216M92 70v12M308 70v12M332 100v174M326 100h12M326 274h12" style={k()} pathLength="1" />
      </g>
    )}
    {kind === 'lock' && (
      <g class="fig-art">
        <path class="dr dash" d="M120 40V360M280 40V360" style={k()} pathLength="1" />
        <rect class="dr" x="168" y="60" width="64" height="270" style={k()} pathLength="1" />
        <rect class="dr" x="178" y="80" width="44" height="30" style={k()} pathLength="1" />
        {dots(186, 128, 3, 4, 14).map((d) => <circle class="dr" cx={d.x} cy={d.y} r={d.r} style={k()} pathLength="1" />)}
        <circle class="dr" cx="200" cy="210" r="11" style={k()} pathLength="1" />
        <path class="dr" d="M232 238h56a6 6 0 0 1 0 12h-56" style={k()} pathLength="1" />
        <circle class="dr" cx="200" cy="300" r="6" style={k()} pathLength="1" />
        <path class="dim" d="M150 60v270M144 60h12M144 330h12" style={k()} pathLength="1" />
      </g>
    )}
    {kind === 'villa' && (
      <g class="fig-art">
        <path class="dr" d="M30 320H370" style={k()} pathLength="1" />
        <path class="dr" d="M70 320V170H210V320" style={k()} pathLength="1" />
        <path class="dr" d="M190 320V110H330V320" style={k()} pathLength="1" />
        <path class="dr" d="M60 170H220M180 110H340" style={k()} pathLength="1" />
        <rect class="dr" x="210" y="140" width="46" height="60" style={k()} pathLength="1" />
        <rect class="dr" x="270" y="140" width="40" height="60" style={k()} pathLength="1" />
        <rect class="dr" x="92" y="200" width="44" height="44" style={k()} pathLength="1" />
        <rect class="dr" x="182" y="250" width="36" height="70" style={k()} pathLength="1" />
        <path class="dr" d="M230 240h80v30h-80z" style={k()} pathLength="1" />
        <path class="dr dash" d="M200 320v40M160 340h80" style={k()} pathLength="1" />
        <path class="dim" d="M350 110v210M344 110h12M344 320h12" style={k()} pathLength="1" />
      </g>
    )}
    {kind === 'devices' && (
      <g class="fig-art">
        <rect class="dr" x="70" y="70" width="96" height="96" style={k()} pathLength="1" />
        <path class="dr" d="M102 70v96M134 70v96" style={k()} pathLength="1" />
        <circle class="dr" cx="275" cy="118" r="50" style={k()} pathLength="1" />
        <circle class="dr" cx="275" cy="118" r="30" style={k()} pathLength="1" />
        <rect class="dr" x="80" y="228" width="150" height="104" style={k()} pathLength="1" />
        <rect class="dr" x="92" y="240" width="100" height="80" style={k()} pathLength="1" />
        <rect class="dr" x="262" y="222" width="36" height="120" style={k()} pathLength="1" />
        {dots(272, 242, 2, 3, 16, 3).map((d) => <circle class="dr" cx={d.x} cy={d.y} r={d.r} style={k()} pathLength="1" />)}
        <path class="dim dash" d="M166 118h59M230 280h32M118 166v62" style={k()} pathLength="1" />
      </g>
    )}
    {kind === 'signal' && (
      <g class="fig-art">
        <circle class="dr" cx="200" cy="200" r="10" style={k()} pathLength="1" />
        {[44, 84, 124, 164].map((r) => <circle class="dr dash" cx="200" cy="200" r={r} style={k()} pathLength="1" />)}
        <rect class="dr" x="96" y="96" width="64" height="44" style={k()} pathLength="1" />
        <path class="dr" d="M96 96l32 24 32-24" style={k()} pathLength="1" />
        <path class="dr" d="M258 262h30a8 8 0 0 1 8 8v30l-12-10h-26a8 8 0 0 1-8-8v-12a8 8 0 0 1 8-8z" style={k()} pathLength="1" />
        <path class="dr" d="M160 130 190 190M270 262 210 210" style={k()} pathLength="1" />
      </g>
    )}
  </svg>
  <Reticle x={tx} y={ty} label={label} class="ret--ink" />
</figure>
