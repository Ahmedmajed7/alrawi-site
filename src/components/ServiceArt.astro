---
/** One small line drawing per service (the ledger's right-hand illustration): fine brass line art that draws in once. */
interface Props { kind: string }
const { kind } = Astro.props;
let n = 0; const k = () => `--k:${n++}`;
---
<svg class="art" viewBox="0 0 200 120" aria-hidden="true">
  <path class="art-base" d="M10 110H190" />
  {kind === 'energy' && <>
    {[30, 58, 86, 114].map((x, i) => <rect class="dr" x={x} y={100 - [30, 52, 38, 70][i]} width="18" height={[30, 52, 38, 70][i]} style={k()} pathLength="1" />)}
    <path class="dr" d="M162 22l-16 34h14l-8 30 22-40h-14l10-24z" style={k()} pathLength="1" />
  </>}
  {kind === 'automation' && <>
    <path class="dr" d="M30 100V58l44-34 44 34v42z" style={k()} pathLength="1" />
    <path class="dr" d="M62 100V74h24v26" style={k()} pathLength="1" />
    <rect class="dr" x="140" y="30" width="36" height="66" style={k()} pathLength="1" />
    <path class="dr" d="M150 50h16M150 60h10M118 64h16" style={k()} pathLength="1" />
  </>}
  {kind === 'environment' && <>
    <circle class="dr" cx="70" cy="62" r="40" style={k()} pathLength="1" />
    <path class="dr" d="M42 90a40 40 0 0 1 56-56" style={k()} pathLength="1" />
    <path class="dr" d="M70 62l18-18" style={k()} pathLength="1" />
    <path class="dr" d="M140 30v44a14 14 0 1 0 12 0V30a6 6 0 0 0-12 0z" style={k()} pathLength="1" />
  </>}
  {kind === 'security' && <>
    <path class="dr" d="M60 18l36 12v26c0 26-18 42-36 48-18-6-36-22-36-48V30z" style={k()} pathLength="1" />
    <path class="dr" d="M44 60l12 12 22-24" style={k()} pathLength="1" />
    <path class="dr" d="M124 40h48l10 14-10 14h-48z" style={k()} pathLength="1" />
    <path class="dr" d="M148 68v30M136 98h24" style={k()} pathLength="1" />
  </>}
  {kind === 'lighting' && <>
    <path class="dr" d="M60 20a26 26 0 0 0-14 48v14h28V68a26 26 0 0 0-14-48z" style={k()} pathLength="1" />
    <path class="dr" d="M60 6v6M24 20l5 5M96 20l-5 5M50 90h20" style={k()} pathLength="1" />
    <path class="dr" d="M120 70h64" style={k()} pathLength="1" />
    <circle class="dr" cx="164" cy="70" r="7" style={k()} pathLength="1" />
  </>}
  {kind === 'entertainment' && <>
    <rect class="dr" x="28" y="24" width="52" height="80" style={k()} pathLength="1" />
    <circle class="dr" cx="54" cy="76" r="16" style={k()} pathLength="1" />
    <circle class="dr" cx="54" cy="42" r="7" style={k()} pathLength="1" />
    <path class="dr" d="M104 48a24 24 0 0 1 0 32M122 36a42 42 0 0 1 0 56M140 24a60 60 0 0 1 0 80" style={k()} pathLength="1" />
  </>}
</svg>
