---
/** Section head: an optional small-caps kicker with a brass hairline, a serif title, a short brass rule and a lead. */
interface Props { label?: string; title: string; lead?: string; center?: boolean; tag?: 'h1' | 'h2' }
const { label, title, lead, center = false, tag: Tag = 'h2' } = Astro.props;
---
<header class:list={['sh', { center }]} data-reveal>
  {label && <span class="kicker">{label}</span>}
  <Tag class="sh-title" set:html={title} />
  {lead && <p class="sh-lead">{lead}</p>}
  <slot />
</header>
