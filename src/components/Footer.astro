---
import type { Locale } from '@/i18n/utils';
import { useT, localePath, l } from '@/i18n/utils';
import Logo from '@/components/Logo.astro';
import Icon from '@/components/Icons.astro';
import site from '@/data/site.json';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
const year = new Date().getFullYear();
const links = [
  { href: localePath(locale), label: t('nav.home') },
  { href: localePath(locale, 'about'), label: t('nav.about') },
  { href: localePath(locale, 'smart-control'), label: t('nav.control') },
  { href: localePath(locale, 'products'), label: t('nav.products') },
  { href: localePath(locale, 'contact'), label: t('nav.contact') },
];
const mark = t('walk.title').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
---
<footer class="footer" data-tone="dusk">
  <i class="footer-lit" aria-hidden="true"></i>
  <div class="wrap footer-inner">
    <div class="footer-brand" data-reveal>
      <a class="nav-logo" href={localePath(locale)} aria-label={l(site.name, locale)}><Logo /><span>{locale === 'ar' ? 'الراوي' : 'AL RAWI'}<small>{locale === 'ar' ? 'للمنازل الذكية' : 'SMART HOME'}</small></span></a>
      <p>{t('footer.tagline')}</p>
      <a class="footer-ig" href={site.instagram} target="_blank" rel="noopener"><Icon name="instagram" /><span>{t('footer.instagram')}</span><Icon name="arrow" class="icon-dir" /></a>
    </div>
    <div class="footer-info" data-reveal style="--d:0.1s">
      <h4 class="label">{t('footer.official')}</h4>
      <ul>
        {site.offices.map((o) => (
          <li>
            <b>{l(o.country, locale)}</b>
            <address>{l(o.address, locale)}</address>
            <span class="footer-phones">{o.phones.map((p) => <a class="num" href={`tel:${p.replace(/\s/g, '')}`}>{p}</a>)}</span>
          </li>
        ))}
        <li><a class="latin footer-mail" href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
    <nav class="footer-nav" data-reveal style="--d:0.2s" aria-label={t('nav.menu')}>
      {links.map((x) => <a href={x.href}>{x.label}</a>)}
    </nav>
  </div>
  <div class="wrap footer-bottom">
    <span>© <span class="num">{year}</span> {t('footer.rights')}</span>
    <span class="latin">alrawioman.com</span>
  </div>
  <div class="footer-mark caps" aria-hidden="true" data-reveal="fade">{mark}</div>
</footer>
