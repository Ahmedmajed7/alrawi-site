---
import '@/styles/index.css';
import type { Locale } from '@/i18n/utils';
import { dir } from '@/i18n/utils';
import Head from '@/components/Head.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFab from '@/components/WhatsAppFab.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'product';
  jsonLd?: Record<string, unknown>[];
  /** nav starts on a light background (inner pages) */
  lightNav?: boolean;
  noindex?: boolean;
  bodyClass?: string;
}
const { locale, title, description, image, type, jsonLd, lightNav = false, noindex, bodyClass = '' } = Astro.props;
---
<!doctype html>
<html lang={locale} dir={dir(locale)} class="no-js">
  <head>
    <Head {locale} {title} {description} {image} {type} {jsonLd} {noindex} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">{locale === 'ar' ? 'انتقل إلى المحتوى' : 'Skip to content'}</a>
    <div class="grain" aria-hidden="true"></div>
    <Nav {locale} light={lightNav} />
    <main id="main">
      <slot />
    </main>
    <Footer {locale} />
    <WhatsAppFab {locale} />
    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>
