---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icons.astro';
import { staticLangPaths, useT, l, localePath, type Locale } from '@/i18n/utils';
import site from '@/data/site.json';
import services from '@/data/services.json';
export const getStaticPaths = staticLangPaths;
const locale = Astro.params.lang as Locale;
const t = useT(locale);
const brand = l(site.name, locale);
const wa = `https://wa.me/${site.whatsapp}`;
---
<Base {locale} title={`${t('meta.servicesTitle')} | ${brand}`} description={t('services.title') + '. ' + services.map((x) => l(x.name, locale)).join(', ')}>
  <section class="cat-hero">
    <img src="/img/categories/services.webp" alt="" width="1600" height="1000" fetchpriority="high" />
    <div class="hero-veil"></div>
    <div class="wrap" style="position:relative;z-index:2">
      <span class="eyebrow">{t('services.eyebrow')}</span>
      <h1>{t('services.title')}</h1>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="grid grid-2" data-stagger>
        {services.map((x) => (
          <div class="card" style="padding:32px" data-reveal>
            <span class="svc-icon" style="background:var(--accent-soft);color:var(--accent);width:52px;height:52px;border-radius:14px;display:grid;place-items:center;margin-bottom:18px"><Icon name={x.icon} /></span>
            <h2 style="font-size:var(--fs-h3);margin-bottom:10px">{l(x.name, locale)}</h2>
            <p style="color:var(--ink-soft)">{l(x.blurb, locale)}</p>
          </div>
        ))}
      </div>
      <div class="cta-actions" style="margin-top:40px">
        <a class="btn btn-wa" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t('cta.whatsapp')}</a>
        <a class="btn btn-ghost" href={localePath(locale, 'products')}>{t('categories.all')} <Icon name="arrow" class="icon-dir" /></a>
      </div>
    </div>
  </section>
</Base>
