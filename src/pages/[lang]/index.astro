---
import Base from '@/layouts/Base.astro';
import Walkthrough from '@/components/Walkthrough.astro';
import Icon from '@/components/Icons.astro';
import SecHead from '@/components/SecHead.astro';
import Stat from '@/components/Stat.astro';
import ServiceArt from '@/components/ServiceArt.astro';
import { staticLangPaths, useT, strings, l, type Locale } from '@/i18n/utils';
import site from '@/data/site.json';
import services from '@/data/services.json';
import film from '@/data/film.json';
import { LOGO_PATHS, LOGO_VIEWBOX } from '@/data/logo';

export const getStaticPaths = staticLangPaths;
const locale = Astro.params.lang as Locale;
const t = useT(locale);
const s = strings(locale);
const heroPoster = film.clips.find((c) => c.id === 'hero')?.poster ?? '/img/brand/villa-poster.webp';
const two = (n: number) => String(n).padStart(2, '0');
const helpline = site.offices[0].phones[0];
// the live site's home, in its order: slider lines, About us, Our Services, Why Choose Us, How It Works, two questions
---
<Base {locale} title={t('meta.siteTitle')} description={t('meta.siteDescription')}>
  <link slot="head" rel="preload" as="image" href={heroPoster} fetchpriority="high" />
  <Walkthrough {locale} />

  <!-- hand-off from the film: the logo's colours in light; the live slider's lines -->
  <section class="band band--paper hero2" id="philosophy" data-tone="lime" data-reveal="stage" data-hero2>
    <canvas class="net" data-net="logo" aria-hidden="true"></canvas>
    <div class="aurora" aria-hidden="true"><i class="au au-blue"></i><i class="au au-green"></i></div>
    <div class="grid-lit" aria-hidden="true"></div>
    <!-- the logo's three 45° strokes as light beams: they sweep in when the film hands over, pulses of light run along
         their cores, and they lean with the pointer and spread apart as the page scrolls on -->
    <div class="beams" aria-hidden="true">
      <i class="bm bm-navy"><b class="pulse" style="--pd:0s"></b></i>
      <i class="bm bm-blue"><b class="pulse" style="--pd:1.2s"></b><b class="pulse" style="--pd:3.4s"></b></i>
      <i class="bm bm-green"><b class="pulse" style="--pd:2.1s"></b></i>
    </div>
    <div class="wrap hero2-inner">
      <div class="mark-wrap">
        <i class="mark-halo" aria-hidden="true"></i>
        <svg class="mark" viewBox={`0 0 ${LOGO_VIEWBOX[0]} ${LOGO_VIEWBOX[1]}`} aria-hidden="true">
          <defs>
            <clipPath id="mk-clip">{LOGO_PATHS.map((p) => <path d={p.d} />)}</clipPath>
            <linearGradient id="mk-shine" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset="0.5" stop-color="#fff" stop-opacity="0.85" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path class="mk-body" d={LOGO_PATHS[0].d} pathLength="1" />
          <path class="mk-blue" d={LOGO_PATHS[1].d} />
          <path class="mk-green" d={LOGO_PATHS[2].d} />
          <g clip-path="url(#mk-clip)"><rect class="mk-sheen" x="-260" y="-100" width="220" height="800" fill="url(#mk-shine)" /></g>
        </svg>
      </div>
      <span class="sh-coord hero2-coord"><span data-decode data-delay="1350">{l(site.name, locale)}</span></span>
      <h2 class="hero2-title">
        <span class="caps h2-l1" data-split>{t('hero.l1')}</span>
        <span class="h2-l2"><span class="h2-l2-in">{t('hero.l2')}</span></span>
      </h2>
      <p class="hero2-sub"><span class="caps">{t('hero.l3')}</span><i class="hit" aria-hidden="true"></i></p>
      <p class="hero2-lead">{t('hero.lead')}</p>
      <a class="hero2-cue" href="#about-us" aria-label={t('aboutUs.eyebrow')}><i></i></a>
    </div>
  </section>

  <!-- 01 About us -->
  <section class="band band--paper" id="about-us" data-tone="lime">
    <div class="wrap about-grid">
      <div class="about-text">
        <SecHead label={t('aboutUs.eyebrow')} title={t('aboutUs.title')} />
        <blockquote class="about-quote" data-reveal>
          <span class="label">{t('aboutUs.brand')}</span>
          <p>“{t('aboutUs.quote')}”</p>
        </blockquote>
        <p class="about-welcome" data-reveal style="--d:0.1s">{t('aboutUs.welcome')}</p>
        <ul class="about-feats" data-stagger="0.1">
          {s.aboutUs.features.map((f, i) => <li data-reveal><span class="feat-ic"><Icon name={i ? 'bulb' : 'check'} /></span><span>{f}</span></li>)}
        </ul>
        <a class="helpline" href={`tel:${helpline.replace(/\s/g, '')}`} data-reveal data-magnetic>
          <span class="helpline-dot" aria-hidden="true"></span>
          <span class="label">{t('aboutUs.helpline')}</span>
          <b class="num">{helpline}</b>
          <Icon name="phone" />
        </a>
      </div>
      <div class="panel" data-reveal>
        <div class="stats">
          {s.aboutUs.stats.map((x) => <Stat n={x.n} suffix={x.suffix} label={x.label} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Our Services: the editorial ledger -->
  <section class="band band--mist" id="services" data-tone="lime">
    <div class="wrap">
      <SecHead label={t('services.eyebrow')} title={t('services.title')} lead={t('services.intro')} />
      <div class="ledger">
        {services.map((x, i) => (
          <article class="row" data-reveal>
            <span class="row-no num">{two(i + 1)}</span>
            <div class="row-name"><h3>{l(x.name, locale)}</h3><em>{l(x.sub, locale)}</em></div>
            <p class="row-body">{l(x.body, locale)}</p>
            <div class="row-art"><ServiceArt kind={x.slug} /></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 Why Choose Us -->
  <section class="band band--paper" id="why" data-tone="lime">
    <div class="wrap">
      <SecHead title={t('why.title')} />
      <ol class="why-grid">
        {s.why.items.map((x, i) => (
          <li class="why" data-reveal style={`--d:${(i % 2) * 0.1}s`}>
            <span class="why-no num">{two(i + 1)}</span>
            <div><h3>{x.title}</h3><p>{x.body}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 How It Works: the flight arc -->
  <section class="band band--mist" id="how" data-tone="lime">
    <div class="wrap">
      <SecHead title={t('how.title')} />
      <div class="rail" data-rail>
        <svg class="rail-arc" viewBox="0 0 1000 120" preserveAspectRatio="none" aria-hidden="true">
          <path class="rail-ghost" d="M0 96 C 250 10, 750 10, 1000 96" />
          <path class="rail-line" d="M0 96 C 250 10, 750 10, 1000 96" pathLength="1" />
        </svg>
        <ol class="rail-steps">
          {s.how.steps.map((x, i) => (
            <li class="rail-step" data-rail-step={i}>
              <span class="rail-node" aria-hidden="true"><i></i></span>
              <span class="rail-no num">{two(i + 1)}</span>
              <h3>{x.title}</h3>
              <p>{x.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 05 the live site's two questions -->
  <section class="band band--paper faq" id="faq" data-tone="lime">
    <div class="wrap faq-grid">
      <div class="faq-head" data-reveal aria-hidden="true">
        <span class="faq-q">{locale === 'ar' ? '؟' : '?'}</span>
      </div>
      <div class="faq-list" data-acc-group>
        {s.faq.items.map((x, i) => (
          <details class="qa" data-acc data-reveal open={i === 0} style={`--d:${i * 0.12}s`}>
            <summary><span class="num qa-no">{two(i + 1)}</span><h3>{x.q}</h3><span class="qa-plus" aria-hidden="true"><Icon name="plus" /></span></summary>
            <div class="acc-body"><p>{x.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script>
    import { initHome } from '@/scripts/motion/home';
    initHome();
  </script>
</Base>
