---
import Base from '@/layouts/Base.astro';
import Walkthrough from '@/components/Walkthrough.astro';
import Icon from '@/components/Icons.astro';
import ProductCard from '@/components/ProductCard.astro';
import ContactForm from '@/components/ContactForm.astro';
import { staticLangPaths, useT, strings, l, localePath, type Locale } from '@/i18n/utils';
import { allCategories, byCategory, featured, categoryOf } from '@/lib/products';
import site from '@/data/site.json';
import services from '@/data/services.json';

export const getStaticPaths = staticLangPaths;
const locale = Astro.params.lang as Locale;
const t = useT(locale);
const s = strings(locale);
const wa = `https://wa.me/${site.whatsapp}`;
const whatPoints = locale === 'ar'
  ? ['الإضاءة والتكييف والستائر من هاتفك أو بصوتك', 'تنبيهات فورية للدخان والغاز والحركة', 'مشاهد جاهزة: صباح، خروج، فيلم، نوم', 'استهلاك طاقة أقل بأجهزة تعمل عند الحاجة فقط']
  : ['Lighting, climate and curtains from your phone or your voice', 'Instant alerts for smoke, gas and movement', 'Ready scenes: morning, away, movie, sleep', 'Lower energy use with devices that run only when needed'];
const sel = featured();
---
<Base {locale} title={t('meta.siteTitle')} description={t('meta.siteDescription')}>
  <link slot="head" rel="preload" as="image" href="/img/brand/intro-poster.webp" fetchpriority="high" />
  <Walkthrough {locale} />

  <section class="section" id="philosophy">
    <div class="wrap philo">
      <div class="philo-text" data-reveal>
        <span class="eyebrow"><span class="no">{t('home.philoNo')}</span>{t('home.philo')}</span>
        <h2 set:html={t('what.title')} />
        <p>{t('what.body')}</p>
        <ul class="philo-list">{whatPoints.map((x, i) => <li><b class="num">{String(i + 1).padStart(2, '0')}</b><span>{x}</span></li>)}</ul>
      </div>
      <figure class="philo-still" data-reveal="fade">
        <div class="img-plate parallax" style="aspect-ratio:5/4"><img src="/img/house/stop-2.webp" alt="" width="1600" height="900" loading="lazy" decoding="async" data-parallax /></div>
        <figcaption><span>{t('home.still')}</span><span class="num">{site.founded}</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="section section-stone" id="collection">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow"><span class="no">{t('home.collectionNo')}</span>{t('home.collection')}</span>
        <h2>{t('home.collectionTitle')}</h2>
      </div>
      <div class="bands">
        {allCategories.map((c, i) => {
          const n = byCategory(c.slug).length;
          return (
            <article class="band" data-reveal>
              <div class="band-media img-plate"><img src={c.image} alt="" width="1600" height="1000" loading="lazy" decoding="async" /></div>
              <div class="band-text">
                <span class="band-no num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{l(c.name, locale)}</h3>
                <p>{l(c.blurb, locale)}</p>
                <div class="band-meta"><span class="num">{n}</span><span>{n === 1 ? t('home.device') : t('home.devices')}</span><span class="link">{t('categories.view')} <Icon name="arrow" class="icon-dir" /></span></div>
              </div>
              <a class="stretch" href={localePath(locale, `products/${c.slug}`)} aria-label={l(c.name, locale)}></a>
            </article>
          );
        })}
        <article class="band" data-reveal>
          <div class="band-media img-plate"><img src="/img/categories/services.webp" alt="" width="1600" height="1000" loading="lazy" decoding="async" /></div>
          <div class="band-text">
            <span class="band-no num">{String(allCategories.length + 1).padStart(2, '0')}</span>
            <h3>{t('services.eyebrow')}</h3>
            <p>{services.map((x) => l(x.name, locale)).join(' · ')}</p>
            <div class="band-meta"><span class="link">{t('services.more')} <Icon name="arrow" class="icon-dir" /></span></div>
          </div>
          <a class="stretch" href={localePath(locale, 'services')} aria-label={t('services.eyebrow')}></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="selected">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow"><span class="no">{t('home.selectedNo')}</span>{t('home.selected')}</span>
        <h2>{t('home.selectedTitle')}</h2>
      </div>
      <div class="story" data-story>
        <div class="story-stage" data-reveal="fade">
          <span class="story-index num" data-story-index>01</span>
          {sel.map((p, i) => <img src={p.image} alt={l(p.name, locale)} width="1200" height="1200" loading="lazy" decoding="async" class:list={[{ 'is-on': i === 0 }]} data-story-img={i} />)}
        </div>
        <div class="story-items">
          {sel.map((p, i) => (
            <div class="story-item" class:list={[{ 'is-on': i === 0 }]} data-story-item={i}>
              <span class="story-cat">{l(categoryOf(p).name, locale)}</span>
              <h3>{l(p.name, locale)}</h3>
              <p>{l(p.description, locale).split('. ')[0]}.</p>
              <a class="link" href={localePath(locale, `products/${p.category}/${p.slug}`)}>{t('featured.view')} <Icon name="arrow" class="icon-dir" /></a>
            </div>
          ))}
        </div>
      </div>
      <p style="margin-top:40px"><a class="btn" href={localePath(locale, 'products')}>{t('categories.all')}</a></p>
    </div>
  </section>

  <section class="section section-stone" id="process">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow"><span class="no">{t('home.processNo')}</span>{t('home.process')}</span>
        <h2>{t('how.title')}</h2>
      </div>
      <div class="process" data-stagger>{s.how.steps.map((st, i) => <div class="step" data-reveal><b class="num">{String(i + 1).padStart(2, '0')}</b><h3>{st.title}</h3><p>{st.body}</p></div>)}</div>
    </div>
  </section>

  <section class="section section-night" id="services">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="eyebrow"><span class="no">{t('home.servicesNo')}</span>{t('home.services')}</span>
        <h2 set:html={t('services.title')} />
      </div>
      <div class="svc-grid" data-stagger>{services.map((x) => <div class="svc" data-reveal><span class="svc-icon"><Icon name={x.icon} /></span><h3>{l(x.name, locale)}</h3><p>{l(x.blurb, locale)}</p></div>)}</div>
    </div>
  </section>

  <section class="section" id="studio">
    <div class="wrap split split-text">
      <div class="studio-visual img-plate parallax" data-reveal="fade"><img src="/img/brand/logo-wall.webp" alt={l(site.name, locale)} width="1200" height="1600" loading="lazy" decoding="async" data-parallax /></div>
      <div data-reveal>
        <div class="section-head" style="margin-bottom:0">
          <span class="eyebrow"><span class="no">{t('home.studioNo')}</span>{t('home.studio')}</span>
          <h2 set:html={t('about.title')} />
          <p>{t('about.body')}</p>
        </div>
        <div class="stats">
          <div><b class="num">{site.founded}</b><span>{t('proof.founded')}</span></div>
          <div><b class="num">10+</b><span>{t('proof.experience')}</span></div>
          <div><b class="num">2</b><span>{t('about.offices')}</span></div>
        </div>
        <p style="margin-top:30px"><a class="link" href={localePath(locale, 'about')}>{t('about.more')} <Icon name="arrow" class="icon-dir" /></a></p>
      </div>
    </div>
  </section>

  <section class="cta" id="contact">
    <div class="wrap cta-inner">
      <div data-reveal>
        <span class="eyebrow">{t('home.contact')}</span>
        <h2 set:html={t('cta.title')} style="margin-top:16px" />
        <p style="margin-top:16px">{t('cta.body')}</p>
        <div class="cta-actions">
          <a class="btn btn-wa" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t('cta.whatsapp')}</a>
          <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
      <div data-reveal="fade"><ContactForm {locale} light /></div>
    </div>
  </section>
  <script>
    import { initStory, initParallax } from '@/scripts/motion/home';
    initStory(); initParallax();
  </script>
</Base>
