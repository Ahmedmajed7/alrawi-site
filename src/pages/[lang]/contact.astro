---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icons.astro';
import PageHero from '@/components/PageHero.astro';
import SecHead from '@/components/SecHead.astro';
import ContactForm from '@/components/ContactForm.astro';
import { staticLangPaths, useT, strings, l, localePath, type Locale } from '@/i18n/utils';
import site from '@/data/site.json';
export const getStaticPaths = staticLangPaths;
const locale = Astro.params.lang as Locale;
const t = useT(locale);
const c = strings(locale).contactPage;
const brand = l(site.name, locale);
const office = site.offices[0];
---
<Base {locale} title={`${t('meta.contactTitle')} | ${brand}`} description={c.body}>
  <PageHero title={c.title} crumbs={[{ href: localePath(locale), label: t('nav.home') }, { label: c.title }]} />

  <section class="band band--paper" data-tone="lime">
    <div class="wrap contact-grid">
      <div class="contact-info">
        <SecHead title={c.h2} lead={c.body} />
        <ul class="contact-list" data-stagger="0.1">
          <li data-reveal>
            <span class="ci-ic"><Icon name="pin" /></span>
            <span class="label">{c.office}</span>
            <a href={office.map} target="_blank" rel="noopener">{l(office.address, locale)}</a>
          </li>
          <li data-reveal>
            <span class="ci-ic"><Icon name="phone" /></span>
            <span class="label">{c.call}</span>
            <span class="ci-phones">{office.phones.map((p) => <a class="num" href={`tel:${p.replace(/\s/g, '')}`}>{p}</a>)}</span>
          </li>
          <li data-reveal>
            <span class="ci-ic"><Icon name="mail" /></span>
            <span class="label">{c.mail}</span>
            <a class="latin" href={`mailto:${site.email}`}>{site.email}</a>
          </li>
        </ul>
      </div>
      <div class="contact-card" data-reveal>
        <div class="contact-card-in">
          <ContactForm {locale} />
        </div>
      </div>
    </div>
  </section>
</Base>
